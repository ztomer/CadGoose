# House gate configuration, read by the author's shared suite when GOH_DIR points at one.
# Every key is optional and this project gates itself without them.
GOH_MAX_LINES=500                 # file-length cap; unset disables the check

# local_ci step list (tools/local_ci.sh delegates to gates/local_ci.sh, which
# reads this). Same steps, same order as the pre-unification orchestrator;
# the optional --coverage step is layered on by tools/local_ci.sh itself.
# NOTE: steps are COLON-separated by the shared runner, so a step string must
# never contain a colon — hence $GOH_DIR resolved here, not ${GOH_DIR:-...}.
# Exported because the shared runner executes steps via `bash -c`, which only
# inherits exported variables.
# GOH_DIR is set in the author's environment; this project does not default it to a path
# that only exists on one machine.
GOH_CI_STEPS='"$GOH_DIR/gates/structural.sh" --full:python3 tools/check_test_registration.py:rm -rf build && cmake -S . -B build -DCMAKE_BUILD_TYPE=Release:cmake --build build --config Release --parallel $(sysctl -n hw.ncpu):cd build && bash ../scripts/run_tests_ci.sh'
# GOH_EXCLUDE='vendor/|\.generated\.'   # shared vendor/generated exemption
# GOH_LINE_EXCLUDE='third_party/'       # length-only alias
# GOH_PY_COV_MIN=95
# GOH_SWIFT_MODE=xcode            # or spm
# GOH_SWIFT_SCHEME=MyAppTests
# GOH_SWIFT_COV_MIN=95
# GOH_MAX_SCRATCH_GB=25           # disk-hygiene ceiling (full runs only)

# DEBT (2026-08-24) resolved 2026-08-25: every over-cap file was split along
# its seams; the blanket tests/ + straggler exemptions are gone. No generated
# or vendored sources exist in this repo, so GOH_LINE_EXCLUDE is unused.

# The goose IS the product: U+1FABF is the app icon (scripts/make_icon.swift
# renders it) and the menu-bar title, with the maple leaf (U+1F341) and the
# hammer-and-sickle (U+262D) as its two themed variants in main.mm. Product
# identity, not decoration -- the way a prompt character is the prompt. The
# status strings that used check-mark-button / cross-mark / cyclone were
# converted to the Kare set on 2026-09-14 when the gate learned to see
# escapes; nothing else is allowed.
GOH_ALLOW='🪿 🍁 ☭'
