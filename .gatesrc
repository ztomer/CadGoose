# House gate configuration, read by the author's shared suite when GOH_DIR points at one.
# Every key is optional and this project gates itself without them.
GOH_MAX_LINES=500                 # file-length cap; unset disables the check

# local_ci step list (tools/local_ci.sh delegates to gates/local_ci.sh, which
# reads this): every gate CI runs, CI's coverage gate included (G0.16: it
# used to be an opt-in --coverage flag the pre-push hook never passed, and a
# push went red in CI after 12 green local steps). $GOH_DIR/checks/check_ci_local_parity.py
# refuses a CI gate script that no step here runs.
# NOTE: steps are COLON-separated by the shared runner, so a step string must
# never contain a colon — hence $GOH_DIR resolved here, not ${GOH_DIR:-...}.
# Exported because the shared runner executes steps via `bash -c`, which only
# inherits exported variables.
# GOH_DIR is set in the author's environment; this project does not default it to a path
# that only exists on one machine.
GOH_CI_STEPS='"$GOH_DIR/gates/structural.sh" --full:bash "$GOH_DIR/gates/python.sh" tools/check_test_registration.py:bash "$GOH_DIR/gates/python.sh" tools/check_gtest_filter_parity.py:bash "$GOH_DIR/gates/python.sh" tools/check_test_process_state.py:bash "$GOH_DIR/gates/python.sh" tools/check_new_sources_visible.py:bash "$GOH_DIR/gates/python.sh" tools/check_platform_policy.py:bash "$GOH_DIR/gates/python.sh" tools/check_test_endpoints.py:bash "$GOH_DIR/gates/python.sh" tools/check_config_dir_isolation.py:bash "$GOH_DIR/gates/python.sh" tools/check_fetchcontent.py:bash "$GOH_DIR/gates/python.sh" tools/check_ci_pins.py:rm -rf build && cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build --config Release --parallel $(sysctl -n hw.ncpu):bash tests/profiling/test_check_quiet_version.sh:bash scripts/check_quiet_version.sh build/CadGoose:cd build && bash ../scripts/run_tests_concurrent.sh:cd build && bash ../scripts/run_tests_shuffled.sh:cd build && bash ../scripts/run_tests_tsan.sh:bash scripts/run_tests_linux.sh:bash tests/profiling/test_run_trail_test.sh:bash scripts/create_bundle.sh --clean && bash "$GOH_DIR/gates/python.sh" tools/check_macos_floor.py --probe:bash "$GOH_DIR/gates/python.sh" "$GOH_DIR/checks/check_ci_local_parity.py":bash scripts/check_coverage.sh --build-dir=build-cov'
# CI/local parity (goh checks/check_ci_local_parity.py). Floor: 14 repo
# scripts in CI's run: steps (check_config_dir_isolation.py joined on
# 2026-10-22 with D1.1; the scan read 13 before it). No exemptions since
# G0.14: scripts/create_bundle.sh was exempt as "packaging, not a gate" until
# the bundle became what proves the macOS floor, so the local gate builds it
# too.
GOH_CI_PARITY_MIN_SCRIPTS=14
GOH_CI_PARITY_EXEMPT=''
# GOH_EXCLUDE='vendor/|\.generated\.'   # shared vendor/generated exemption
# GOH_LINE_EXCLUDE='third_party/'       # length-only alias
# GOH_PY_COV_MIN=95
# GOH_SWIFT_MODE=xcode            # or spm
# GOH_SWIFT_SCHEME=MyAppTests
# GOH_SWIFT_COV_MIN=95
# GOH_MAX_SCRATCH_GB=25           # disk-hygiene ceiling (full runs only)

# DEBT (2026-08-24) resolved 2026-08-25: every over-cap file was split along
# its seams; the blanket tests/ + straggler exemptions are gone. No generated
# or vendored sources exist in this repo, so GOH_LINE_EXCLUDE is unused.

# The goose IS the product: U+1FABF is the app icon (scripts/make_icon.swift
# renders it) and the menu-bar title, with the maple leaf (U+1F341) and the
# hammer-and-sickle (U+262D) as its two themed variants in main.mm. Product
# identity, not decoration -- the way a prompt character is the prompt. The
# status strings that used check-mark-button / cross-mark / cyclone were
# converted to the Kare set on 2026-09-14 when the gate learned to see
# escapes; nothing else is allowed.
GOH_ALLOW='🪿 🍁 ☭'

# Every process call names its stdin (the house stdin gate, `goh
# subprocess-stdin`). Every one of the ten calls a full scan reads declares
# it: nine feed their child nothing (`stdin=subprocess.DEVNULL`), and
# check_macos_floor.py feeds the compiler its source through `input=`. There
# is no allowlist file. The floor below was 1, from the day the scan read a
# single call; the tree moved, and a floor that low cannot catch a scan that
# lost its subject.
GOH_SUBPROCESS_STDIN=on

# Every scanner's floor (goh v0.27.0, docs/config.md): a full-scope scan that
# reads less than this has lost its subject and is red, not clean. Nine tenths
# of what each read on 2026-10-14 (the house rule); lower one with the tree in
# the same commit, never to absorb a scan that went blind.
GOH_EMOJI_MIN_FILES=522               # read 581
GOH_CONFLICT_MARKERS_MIN_FILES=647    # read 719
GOH_FILE_LENGTH_MIN_FILES=357         # read 397
GOH_SECRETS_MIN_FILES=522             # read 581
GOH_SHELL_LINT_MIN_FILES=23           # read 26
GOH_EARLY_EXIT_PIPE_MIN_FILES=27      # read 31
GOH_DEAD_AFTER_EXEC_MIN_FILES=27      # read 31
GOH_BARE_HOOK_INDEX_MIN_FILES=27      # read 31
GOH_BARE_PYTHON_MIN_FILES=5           # read 6
GOH_CHECKOUT_CREDENTIALS_MIN_FILES=2  # read 3
GOH_MD_LINKS_MIN_LINKS=7              # read 8
GOH_UNREAPED_SPAWN_MIN_FILES=4        # read 5
GOH_SUBPROCESS_STDIN_MIN_CALLS=9      # read 10, every one declared (2026-10-20)
GOH_TAP_WRITES_MIN_FILES=52           # read 58 (2026-10-24)
GOH_MOVING_TAGS_MIN_REFS=1            # read 1 (2026-10-24)
GOH_BUSY_LOOP_MIN_FILES=35            # read 39 (2026-10-24)
