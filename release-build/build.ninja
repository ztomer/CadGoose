build multi_goose_test: CXX_EXECUTABLE_LINKER__multi_goose_test_Release CMakeFiles/multi_goose_test.dir/tests/platform/macos/test_multi_goose.mm.o CMakeFiles/multi_goose_test.dir/src/platform/macos/command_socket.cpp.o
  CONFIG = Release
  FLAGS = -O3 -DNDEBUG -arch arm64
  LINK_FLAGS = -Wl,-search_paths_first -Wl,-headerpad_max_install_names
  LINK_LIBRARIES = -framework Cocoa  -framework CoreGraphics  -framework ScreenCaptureKit  -framework CoreVideo  -framework CoreMedia
  OBJECT_DIR = CMakeFiles/multi_goose_test.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_FILE = multi_goose_test
  TARGET_PDB = multi_goose_test.dbg
  TARGET_SUPPORT_DIR = CMakeFiles/multi_goose_test.dir


#############################################
# Utility command for edit_cache

build CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd release-build && /opt/homebrew/bin/ccmake -S$HOME/Projects/CadGoose -Brelease-build
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build edit_cache: phony CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd release-build && /opt/homebrew/bin/cmake --regenerate-during-build -S$HOME/Projects/CadGoose -Brelease-build
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util


#############################################
# Phony custom command for CMakeFiles/CompileSwiftFoundationLLM

build CMakeFiles/CompileSwiftFoundationLLM | ${cmake_ninja_workdir}CMakeFiles/CompileSwiftFoundationLLM: phony FoundationLLM.o


#############################################
# Custom command for FoundationLLM.o

build FoundationLLM.o | ${cmake_ninja_workdir}FoundationLLM.o: CUSTOM_COMMAND src/common/behaviors/FoundationLLM.swift
  COMMAND = cd release-build && swiftc -c -parse-as-library src/common/behaviors/FoundationLLM.swift -o release-build/FoundationLLM.o -emit-module-path release-build/FoundationLLM.swiftmodule -target arm64-apple-macos15 -sdk /Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk
  DESC = Compiling FoundationLLM.swift
  restat = 1

