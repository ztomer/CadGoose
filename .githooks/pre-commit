#!/bin/bash
# pre-commit -- staged-scope gate.
#
# Delegates to tools/gate.sh, which runs this repo's OWN vendored gates always and the author's
# shared house-gate suite only when GOH_DIR points at one. That order matters for a public repo:
# an outside contributor must be able to commit without obtaining a checkout they cannot see, and
# the vendored gates still hold the line for them.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
exec "$root/tools/gate.sh" --staged
