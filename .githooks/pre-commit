#!/bin/bash
# Pre-commit guard installed by init_repo.sh. Block disallowed emoji in STAGED files
# (only the Kare icon set is permitted; emoji are a failure state).
set -euo pipefail
root="$(git rev-parse --show-toplevel)"

python3 "$root/tools/check_no_emoji.py" --staged || {
    echo "pre-commit: disallowed emoji in staged files — only → ✓ ✗ ⚠ ↔ ↑ ↓ are allowed." >&2
    exit 1; }

# Every test file must compile into some target — orphaned test files never
# run, so their coverage of the code is an illusion (~1200 lines were once
# dropped from CMakeLists.txt silently).
python3 "$root/tools/check_test_registration.py" || {
    echo "pre-commit: unregistered test file(s) under tests/ — register them in CMakeLists.txt or delete them." >&2
    exit 1; }
