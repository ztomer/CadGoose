#!/bin/bash
# pre-push -- full-scope gate. There is no CI behind this for the local-only checks, so if this
# does not run, nothing does.
#
# Delegates to tools/gate.sh, which runs this repo's OWN vendored gates always and the author's
# shared house-gate suite only when GOH_DIR points at one.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
exec "$root/tools/gate.sh" --full
